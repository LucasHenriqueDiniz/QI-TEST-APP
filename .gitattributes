# Normaliza fim de linha: o repo guarda LF, cada máquina usa o seu no disco.
# Sem isto, o mesmo arquivo salvo no Windows e no macOS aparece como diff
# inteiro só pela quebra de linha.
* text=auto eol=lf

# Binários: nunca normalizar.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
